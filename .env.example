# Application Configuration
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-secret-key-here

# Database Configuration
DATABASE_URL=sqlite:///intelligent_extraction.db

# AI Model Configuration (Optional - leave empty to use local models only)
OPENAI_API_KEY=
HUGGINGFACE_API_KEY=

# Vision Model Configuration
CLIP_MODEL_NAME=openai/clip-vit-base-patch32

# OCR Configuration
TESSERACT_PATH=/usr/bin/tesseract

# Redis Configuration (for Celery - Optional)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_ACCEPT_CONTENT=['json']
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_TIMEZONE=UTC
CELERY_ENABLE_UTC=True
CELERYD_TASK_SOFT_TIME_LIMIT=110
CELERYD_TASK_TIME_LIMIT=120

# Security Configuration
ENCRYPTION_KEY=your-encryption-key-here

# Performance Configuration
MAX_DOCUMENT_SIZE_MB=50
PROCESSING_TIMEOUT_SECONDS=60
MAX_CONCURRENT_EXTRACTIONS=5

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/extraction.log

# Compliance Configuration
GDPR_COMPLIANCE=True
DATA_RETENTION_DAYS=90
AUDIT_LOG_ENABLED=True

# Python Configuration
PYTHONPATH=/home/ubuntu/intelligent-document-extraction

# RAG Configuration
RAG_ENABLED=True
RAG_KNOWLEDGE_BASE_PATH=data/rag_knowledge_base
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_TOP_K_RESULTS=3
